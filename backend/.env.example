# DVP portal settings. Copy to backend/.env and fill in. Never commit backend/.env.

# ── Server ───────────────────────────────────────────────
PORT=7100
# Behind Nginx in production: 127.0.0.1, so the portal is only reached through Nginx (HTTPS)
HOST=127.0.0.1
# Its own database on the same MongoDB as VRSP (VRSP uses workSystem)
MONGO_URI=mongodb://127.0.0.1:27017/dvpPortal
# At least 32 random characters, different from VRSP's. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Where uploaded files live (reference images, LOP and observation pictures, VR reports). Outside the code folder,
# so updates never touch them. Back this folder up together with the database.
UPLOAD_DIR=/var/lib/dvp-portal/uploads

# ── Microsoft sign-in through VRSP ───────────────────────
# VRSP as the browser sees it, and as this server reaches it (same machine)
SSO_VRSP_URL=https://vrc.mahindra.com
SSO_VRSP_INTERNAL_URL=http://127.0.0.1:7000
# This portal's name in VRSP's SSO_APPS, and the shared secret: the SAME value as VRSP's SSO_APP_DVP_SECRET.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
SSO_APP_NAME=dvp
SSO_APP_SECRET=
# Always admins (comma-separated). Use the email people sign in with (e.g. 25033899@mahindra.com) or their
# name email - both are matched.
ADMIN_EMAILS=

# ── Optional defaults (each can also be changed on the Settings page) ──
# OBSERVATION_MAX_IMAGES=12
# VR_REPORT_MAX_MB=200
